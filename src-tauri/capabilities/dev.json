{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dev",
  "description": "Dev capabilities",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:1420"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "store:allow-get",
    "store:allow-set",
    "store:allow-delete",
    "store:allow-save",
    "store:allow-load",
    "log:allow-log",
    "os:default",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        {
          "url": "https://osu.ppy.sh/*"
        }
      ]
    },
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-home-read-recursive",
    "notification:default",
    "sql:default",
    "sql:allow-execute"
  ]
}