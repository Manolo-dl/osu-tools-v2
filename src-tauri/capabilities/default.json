{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:allow-open",
    "dialog:allow-open",
    "store:allow-get",
    "store:allow-set",
    "store:allow-delete",
    "log:allow-log",
    "core:window:allow-start-dragging",
    "core:app:allow-version",
    "os:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-home-read-recursive",
    "notification:default",
    "updater:default",
    "log:default"
  ]
}
