{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "osu-tools",
  "version": "0.5.0",
  "identifier": "com.manolo.osu-tools",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/osu-tools/browser"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "osu-tools",
        "width": 800,
        "height": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: asset: http://asset.localhost;",
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "/home/manolo/.local/share/osu-wine/osu!/Songs/**",
          "$HOME/.osu-trainer/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/tosu"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2OTU0RjVGM0U2OTY0QzQKUldURVpHaytYMCtWMWpOa0R6c3RnT0NINThQN0crb3BiMkVJZU5RL0xRZHRYWnpQQmV0VmptdjUK",
      "endpoints": [
        "https://github.com/Manolo-dl/osu-tools-v2/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
